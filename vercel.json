{
  "build": {
    "env": {
      "HUGO_VERSION": "0.146.0"
    }
  },
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(css|js|woff|woff2|ico|png|jpg|jpeg|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
